# Base URL the frontend uses for API calls.
# Default "/api" is served by the Vite dev proxy (see vite.config.js) which
# forwards to the backend and avoids CORS. Set to a full URL (e.g.
# https://api.example.com) to call a deployed backend directly.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api requests. Only used by vite.config.js.
VITE_BACKEND_URL=http://localhost:8000
